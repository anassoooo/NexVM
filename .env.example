# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# === VirtualBox (host paths) ===
# Path to VirtualBox installation on the host machine
# Windows example: VBOX_INSTALL_PATH=C:\Program Files\Oracle\VirtualBox
# Linux example: VBOX_INSTALL_PATH=/usr/bin
VBOX_INSTALL_PATH=C:\Program Files\Oracle\VirtualBox

# Path where VMs are stored on the host
# Windows example: VM_STORAGE_HOST_PATH=C:\Users\DELL\VirtualBox VMs
VM_STORAGE_HOST_PATH=
